# Docker files must keep LF line endings, also when checked out on Windows
Dockerfile    text eol=lf
.dockerignore text eol=lf
compose.yaml  text eol=lf
smoke/package/**/*.dll -text -diff
smoke/package/**/*.rgba -text -diff
smoke/package/**/*.shaders -text -diff
smoke/package/**/*.iwd -text -diff
smoke/package/**/*.cmd -text
smoke/custom-occupancy/*.iwd -text -diff
tools/smoke-bake/bin/*.exe -text -diff
